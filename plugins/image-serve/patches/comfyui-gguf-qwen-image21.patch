From 62f144d896bbb4b4574f319de20ff21b9b09cf88 Mon Sep 17 00:00:00 2001
From: owner <1165081+geonom@users.noreply.github.com>
Date: Fri, 25 Sep 2026 10:32:09 +0200
Subject: [PATCH 2/2] Add qwen_image21 to tools/convert.py's detect_arch()
 fallback arch_list

Needed for GGUF files whose own general.architecture metadata isn't set to
a string loader.py's IMG_ARCH_LIST already recognizes (e.g. unsloth's own
Qwen-Image-2.1 GGUF conversion) -- gguf_sd_loader() falls back to this
tensor-key-based detect_arch() when that's the case, and it didn't know
about qwen_image21 either. Same keys_detect as leejet/ComfyUI-GGUF@f912d5e,
applied by hand (not cherry-picked) due to a CRLF conflict in this checkout.
---
 tools/convert.py | 10 ++++++++--
 1 file changed, 8 insertions(+), 2 deletions(-)

diff --git a/tools/convert.py b/tools/convert.py
index 5029c87..9d75f0b 100644
--- a/tools/convert.py
+++ b/tools/convert.py
@@ -145,8 +145,14 @@ class ModelLumina2(ModelTemplate):
         ("cap_embedder.1.weight", "context_refiner.0.attention.qkv.weight")
     ]
 
-arch_list = [ModelFlux, ModelSD3, ModelAura, ModelHiDream, CosmosPredict2, 
-             ModelLTXV, ModelHyVid, ModelWan, ModelSDXL, ModelSD1, ModelLumina2]
+class ModelQwenImage21(ModelTemplate):
+    arch = "qwen_image21"
+    keys_detect = [
+        ("txt_in.text_norm.weight",)
+    ]
+
+arch_list = [ModelFlux, ModelSD3, ModelAura, ModelHiDream, CosmosPredict2,
+             ModelLTXV, ModelHyVid, ModelWan, ModelSDXL, ModelSD1, ModelLumina2, ModelQwenImage21]
 
 def is_model_arch(model, state_dict):
     # check if model is correct
-- 
