{
  "id": "cosyvoice",
  "name": "CosyVoice 3",
  "description": "Clone a reference voice, optionally with a free-form style instruction (variant instruct).",
  "capability": "tts",
  "command": [
    "./venv/bin/python",
    "worker.py",
    "--port",
    "{port}"
  ],
  "env": {
    "COSYVOICE_REPO_DIR": "{dir}/repo"
  },
  "gpu": 0,
  "vram_mb": 3700,
  "startup_timeout_s": 90,
  "keep_alive_s": 60,
  "aliases": [
    "cosy",
    "cosyvoice3"
  ],
  "variants": [
    "zero_shot",
    "instruct",
    "cross_lingual"
  ],
  "default_reference": true,
  "license": "Apache-2.0",
  "setup": "./setup.sh",
  "languages": [
    "zh",
    "en",
    "ja",
    "ko",
    "de",
    "es",
    "fr",
    "it",
    "ru"
  ],
  "modes": [
    {
      "variant": "zero_shot",
      "label": "Clone a voice",
      "description": "Clones the voice from the recording; most accurate with a transcript (without: like 'Cross-lingual').",
      "inputs": {
        "reference": "required",
        "ref_text": "optional"
      },
      "params": [
        {
          "name": "speed",
          "label": "Speed",
          "min": 0.5,
          "max": 2.0,
          "step": 0.05,
          "default": 1.0
        }
      ]
    },
    {
      "variant": "instruct",
      "label": "Clone with a style",
      "description": "Clones the voice and speaks in the described style.",
      "inputs": {
        "reference": "required",
        "instruct": "required"
      },
      "instruct": {
        "kind": "text",
        "hint": "How should it be spoken?",
        "examples": [
          "Speak slowly and calmly.",
          "Speak cheerfully and excitedly.",
          "Speak like a grumpy old man."
        ]
      },
      "params": [
        {
          "name": "speed",
          "label": "Speed",
          "min": 0.5,
          "max": 2.0,
          "step": 0.05,
          "default": 1.0
        }
      ]
    },
    {
      "variant": "cross_lingual",
      "label": "Cross-lingual",
      "description": "Clones only the sound of the voice, without a transcript; good when the recording and the text are in different languages.",
      "inputs": {
        "reference": "required"
      },
      "params": [
        {
          "name": "speed",
          "label": "Speed",
          "min": 0.5,
          "max": 2.0,
          "step": 0.05,
          "default": 1.0
        }
      ]
    }
  ]
}
