{
  "id": "chatterbox",
  "name": "Chatterbox Multilingual",
  "description": "Optional reference clone; expressiveness via exaggeration / cfg_weight / temperature. Output carries an inaudible Perth watermark.",
  "capability": "tts",
  "command": [
    "./venv/bin/python",
    "worker.py",
    "--port",
    "{port}"
  ],
  "gpu": 0,
  "vram_mb": 4000,
  "startup_timeout_s": 60,
  "keep_alive_s": 60,
  "aliases": [
    "chatter"
  ],
  "default_reference": false,
  "license": "MIT",
  "setup": "./setup.sh",
  "languages": [
    "ar",
    "da",
    "de",
    "el",
    "en",
    "es",
    "fi",
    "fr",
    "he",
    "hi",
    "it",
    "ja",
    "ko",
    "ms",
    "nl",
    "no",
    "pl",
    "pt",
    "ru",
    "sv",
    "sw",
    "tr",
    "zh"
  ],
  "modes": [
    {
      "variant": null,
      "label": "Speak",
      "description": "With a recording the voice is cloned, without one the built-in voice speaks. Expression through the sliders.",
      "inputs": {
        "reference": "optional"
      },
      "params": [
        {
          "name": "exaggeration",
          "label": "Expression",
          "min": 0.0,
          "max": 2.0,
          "step": 0.05,
          "default": 0.5
        },
        {
          "name": "cfg_weight",
          "label": "Guidance (CFG)",
          "min": 0.0,
          "max": 1.0,
          "step": 0.05,
          "default": 0.5
        },
        {
          "name": "temperature",
          "label": "Temperature (randomness)",
          "min": 0.05,
          "max": 2.0,
          "step": 0.05,
          "default": 0.8
        }
      ]
    }
  ]
}
