{
  "id": "comfyui",
  "name": "ComfyUI",
  "description": "Images with ComfyUI (Z-Image Turbo, ERNIE, Qwen-Image-Edit, MOSS-Image with text and layout), plus sound effects (Stable Audio 3) and music (ACE-Step 1.5) -- an image and audio plugin for ai-serve. ComfyUI starts only when it's needed.",
  "command": [
    "./run.sh"
  ],
  "env": {
    "PORT": "{port}"
  },
  "port": 8189,
  "bind": "127.0.0.1",
  "match": [
    "image_serve.app"
  ],
  "health_path": "/health",
  "status_path": "/plugin/status",
  "category": "ai",
  "icon": "image",
  "identity": "single",
  "provides": {
    "image": {
      "catalog": "/v1/images/models",
      "generate": "/v1/images/generations",
      "edit": "/v1/images/edits",
      "cancel": "/v1/images/cancel",
      "comfyui_api": "/api/comfyui",
      "status": "/plugin/status",
      "release": "/plugin/release",
      "logs": "/plugin/logs",
      "install": "/plugin/install",
      "gpu": "shared"
    },
    "audio": {
      "catalog": "/v1/audio/models",
      "jobs": "/v1/audio/jobs",
      "status": "/plugin/status",
      "release": "/plugin/release",
      "logs": "/plugin/logs",
      "gpu": "shared"
    }
  }
}
