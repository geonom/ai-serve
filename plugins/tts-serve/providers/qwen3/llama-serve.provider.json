{
  "id": "qwen3",
  "name": "Qwen3-TTS",
  "description": "Three checkpoints: base (clone, needs ref_text), voice_design (voice from a description), custom_voice (9 preset speakers). One held at a time.",
  "capability": "tts",
  "command": [
    "./venv/bin/python",
    "worker.py",
    "--port",
    "{port}"
  ],
  "gpu": 0,
  "vram_mb": 8000,
  "startup_timeout_s": 60,
  "keep_alive_s": 60,
  "aliases": [
    "qwen3tts",
    "qwen3-tts",
    "qwen"
  ],
  "variants": [
    "base",
    "voice_design",
    "custom_voice"
  ],
  "variant_swaps": true,
  "default_reference": false,
  "license": "Apache-2.0",
  "requires": [
    "cuda"
  ],
  "install_mb": 10000,
  "setup": "./setup.sh",
  "languages": [
    "en",
    "zh",
    "ja",
    "ko",
    "de",
    "fr",
    "ru",
    "pt",
    "es",
    "it"
  ],
  "modes": [
    {
      "variant": "base",
      "label": "Clone a voice",
      "description": "Clones the voice from the recording and its transcript.",
      "inputs": {
        "reference": "required",
        "ref_text": "required"
      },
      "params": [
        {
          "name": "seed",
          "label": "Seed (same seed + description = same voice)",
          "min": 0,
          "max": 2147483647,
          "step": 1
        }
      ]
    },
    {
      "variant": "voice_design",
      "label": "Describe a voice",
      "description": "Builds a voice from a description, without a recording.",
      "inputs": {
        "instruct": "required"
      },
      "instruct": {
        "kind": "text",
        "hint": "Sound, age, feeling, way of speaking",
        "examples": [
          "A warm, calm female voice in her forties, speaking slowly.",
          "An excited boy, about ten years old, speaking fast."
        ]
      },
      "params": [
        {
          "name": "seed",
          "label": "Seed (same seed + description = same voice)",
          "min": 0,
          "max": 2147483647,
          "step": 1
        }
      ]
    },
    {
      "variant": "custom_voice",
      "label": "Preset speakers",
      "description": "One of nine built-in speakers, optionally with a style.",
      "inputs": {
        "speaker": "required",
        "instruct": "optional"
      },
      "speakers": [
        "Vivian",
        "Serena",
        "Uncle_Fu",
        "Dylan",
        "Eric",
        "Ryan",
        "Aiden",
        "Ono_Anna",
        "Sohee"
      ],
      "instruct": {
        "kind": "text",
        "hint": "Style (optional)",
        "examples": [
          "Speak sadly.",
          "Speak with excitement."
        ]
      },
      "params": [
        {
          "name": "seed",
          "label": "Seed (same seed + description = same voice)",
          "min": 0,
          "max": 2147483647,
          "step": 1
        }
      ]
    }
  ]
}
