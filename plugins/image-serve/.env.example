# An existing ComfyUI checkout to use; default: ./ComfyUI (setup.sh clones the tested release there)
#COMFYUI_DIR=
# The Python that runs it (with torch); default: $COMFYUI_DIR/venv/bin/python
#COMFYUI_PYTHON=
# Where the image models live (its extra_model_paths.yaml); default: $COMFYUI_DIR/models
#COMFYUI_MODELS_ROOT=
# GPU ComfyUI starts on when nothing says otherwise: auto = the one with the most room; a number pins it
#COMFYUI_DEFAULT_GPU_ID=auto
# Images saved with a filename (/api/comfyui/images)
#GENERATED_IMAGES_DIR=
# ComfyUI's own port (loopback; this app passes its web UI through)
#COMFY_PORT=8192
#AI_SERVE_URL=http://127.0.0.1:8030
