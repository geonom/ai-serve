# Copy to ai-serve.local.env (gitignored) and change what you need. Without it, ai-serve runs with these defaults:
# only this machine (localhost), models in ./models and ~/gguf_models, llama-server from ./runtimes or PATH.

# Where .gguf models are (comma-separated)
#LLAMA_MODEL_DIRS=./models,~/gguf_models
# A llama-server of your own instead of the one the installer fetched
#LLAMA_SERVER_BIN=/path/to/llama-server
# What "Auto" chats load when nothing suitable is running
#DEFAULT_CHAT_MODEL=gemma-4-12b-it-qat-q4_0.gguf

# Who may use the dashboard/APIs besides this machine: none (default) = only this machine, plus clients that send
# LLAMA_SERVE_API_KEY (>= 32 characters). Extensions: tailscale (the owner's tailnet devices) or static (WireGuard etc.)
#NETWORK_PROVIDER=none
#LLAMA_SERVE_API_KEY=

# Folders whose subfolders are apps with a llama-serve.service.json (Apps & Services). Speech, transcription,
# access for other people (the door) ... are plugins: apps there that declare what they provide (docs/plugins.md)
#SERVICE_ROOTS=./apps:./plugins
# Hugging Face token for gated models, e.g. pyannote's speaker diarization (accept its terms on the model page first)
#HF_TOKEN=
# Whisper model for speech recognition: tiny, base, small (default), medium, large-v3, turbo ... (docs/models.md)
#STT_WHISPER_MODEL=small
# Transcription engine used when a request names none; empty = the first available default among the STT plugins
#DEFAULT_STT_ENGINE=
# Speech engine used when a request names none; empty = the TTS plugin's first installed one
#DEFAULT_TTS_ENGINE=

# Optional extensions -- empty = not installed
# Image generation is a plugin too: image-serve (ComfyUI), sd-serve (Iris), comfyui-moss (MOSS) -- docs/plugins.md

# The gateway's port and listen address (default 8030, all interfaces -- who may use it is decided by the
# access policy: this machine, your overlay devices, others only with LLAMA_SERVE_API_KEY). Plugins learn it as AI_SERVE_URL.
#AI_SERVE_PORT=8030
#AI_SERVE_HOST=0.0.0.0
