# Your Strata install (https://github.com/Niko1221/Strata) -- nothing of it is copied here
STRATA_DIR=
# Engine config inside it (default: $STRATA_DIR/strata-iq3_s.json)
#STRATA_CONFIG=
# Port Strata's own server listens on (loopback only)
#STRATA_PORT=8080
# Seconds to wait for Strata to finish loading
#STRATA_START_TIMEOUT=1800
# Idle seconds before Strata is stopped again; 0 = never (a reload takes 4-10 min)
#STRATA_KEEP_ALIVE=0
# More names requests may use for Strata (comma-separated), e.g. a benchmark's model handle
#STRATA_ALIASES=
# The ai-serve gateway that owns the GPUs
#AI_SERVE_URL=http://127.0.0.1:8030
