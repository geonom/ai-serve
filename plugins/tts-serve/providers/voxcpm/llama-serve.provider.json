{
  "id": "voxcpm",
  "name": "VoxCPM2 (Nano-vLLM)",
  "description": "Fast reference clone; batches concurrent requests. Reserves vram_fraction of the card up front.",
  "capability": "tts",
  "command": [
    "./venv/bin/python",
    "worker.py",
    "--port",
    "{port}"
  ],
  "env": {
    "VOXCPM_GPU": "0",
    "VOXCPM_GPU_MEM": "{vram_fraction}"
  },
  "gpu": 0,
  "vram_fraction": 0.5,
  "startup_timeout_s": 120,
  "keep_alive_s": 360,
  "concurrent": true,
  "aliases": [
    "voxcpm2"
  ],
  "variants": [
    "reference",
    "prompt"
  ],
  "default_reference": true,
  "license": "Apache-2.0",
  "setup": "./setup.sh",
  "modes": [
    {
      "variant": "reference",
      "label": "Clone a voice",
      "description": "Clones the voice from the recording.",
      "inputs": {
        "reference": "required"
      },
      "params": [
        {
          "name": "cfg_weight",
          "label": "Guidance (CFG)",
          "min": 1.0,
          "max": 5.0,
          "step": 0.1,
          "default": 2.0
        },
        {
          "name": "temperature",
          "label": "Temperature (randomness)",
          "min": 0.05,
          "max": 2.0,
          "step": 0.05,
          "default": 1.0
        }
      ]
    },
    {
      "variant": "prompt",
      "label": "Clone with a transcript",
      "description": "Recording plus transcript: more accurate, continues the recording.",
      "inputs": {
        "reference": "required",
        "ref_text": "required"
      },
      "params": [
        {
          "name": "cfg_weight",
          "label": "Guidance (CFG)",
          "min": 1.0,
          "max": 5.0,
          "step": 0.1,
          "default": 2.0
        },
        {
          "name": "temperature",
          "label": "Temperature (randomness)",
          "min": 0.05,
          "max": 2.0,
          "step": 0.05,
          "default": 1.0
        }
      ]
    }
  ]
}
