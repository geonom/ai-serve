{
  "id": "chatterbox-mlx",
  "name": "Chatterbox Multilingual (MLX, Mac)",
  "description": "Chatterbox Multilingual auf Apple Silicon über MLX (mlx-audio, mlx-community/chatterbox-multilingual-v3): Deutsch und 22 weitere Sprachen, optionale Stimme zum Klonen. Läuft nur auf dem Mac.",
  "capability": "tts",
  "command": [
    "./venv/bin/python",
    "worker.py",
    "--port",
    "{port}"
  ],
  "gpu": 0,
  "vram_mb": 3500,
  "startup_timeout_s": 120,
  "keep_alive_s": 60,
  "aliases": [
    "chatterbox-mac"
  ],
  "default_reference": false,
  "license": "MIT",
  "setup": "./setup.sh",
  "languages": [
    "ar",
    "da",
    "de",
    "el",
    "en",
    "es",
    "fi",
    "fr",
    "he",
    "hi",
    "it",
    "ja",
    "ko",
    "ms",
    "nl",
    "no",
    "pl",
    "pt",
    "ru",
    "sv",
    "sw",
    "tr",
    "zh"
  ],
  "modes": [
    {
      "variant": null,
      "label": "Sprechen",
      "description": "Mit Aufnahme wird die Stimme geklont, ohne spricht die eingebaute Stimme. Ausdruck über Regler.",
      "inputs": {
        "reference": "optional"
      },
      "params": [
        {
          "name": "exaggeration",
          "label": "Ausdruck",
          "min": 0.0,
          "max": 2.0,
          "step": 0.05,
          "default": 0.5
        },
        {
          "name": "cfg_weight",
          "label": "Führung (CFG)",
          "min": 0.0,
          "max": 1.0,
          "step": 0.05,
          "default": 0.5
        },
        {
          "name": "temperature",
          "label": "Temperatur (Zufall)",
          "min": 0.05,
          "max": 2.0,
          "step": 0.05,
          "default": 0.8
        }
      ]
    }
  ]
}
